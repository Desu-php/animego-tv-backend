                "value": {
                  "error": "player is not supported"
                }
              },
              "unavailable": {
                "value": {
                  "error": "playback is unavailable"
                }
              }
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        }
      },
      "CatalogUpstream": {
        "description": "Ошибка, тайм-аут, слишком большой ответ или неожиданная разметка каталога",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "upstream": {
                "value": {
                  "error": "anime catalog is temporarily unavailable"
                }
              }
            }
          }
        }
      },
      "PlaybackUpstream": {
        "description": "Ошибка каталога или плеера, тайм-аут либо неожиданный ответ при получении playback",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "upstream": {
                "value": {
                  "error": "playback provider is temporarily unavailable"
                }
              }
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        }
      },
      "InternalError": {
        "description": "Непредвиденная внутренняя ошибка",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "internal": {
                "value": {
                  "error": "internal server error"
                }
              }
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "Лимит параллельных запросов исчерпан. Повторите запрос через указанное число секунд.",
        "headers": {
          "Retry-After": {
            "description": "Число секунд до повторного запроса.",
            "schema": {
              "type": "string",
              "example": "1"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "server is busy; retry shortly"
            }
          }
        }
