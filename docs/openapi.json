                "value": {
                  "error": "invalid anime or episode identifier"
                }
              }
            }
          }
        }
      },
      "InvalidPlaybackID": {
        "description": "Неверный идентификатор аниме, серии или плеера; первая часть playerID должна совпадать с episodeID",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "invalidIdentifier": {
                "value": {
                  "error": "invalid anime, episode, or player identifier"
                }
              }
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        }
      },
      "AnimeNotFound": {
        "description": "Аниме не найдено",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "animeNotFound": {
                "value": {
                  "error": "anime not found"
                }
              }
            }
          }
        }
      },
      "CatalogNotFound": {
        "description": "Аниме или серия не найдены, включая серию другого аниме",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "animeNotFound": {
                "value": {
                  "error": "anime not found"
                }
              },
              "episodeNotFound": {
                "value": {
                  "error": "episode not found"
                }
              }
            }
          }
        }
      },
      "PlaybackNotFound": {
        "description": "Аниме, серия или выбранный плеер не найдены",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "examples": {
              "animeNotFound": {
                "value": {
                  "error": "anime not found"
                }
              },
              "episodeNotFound": {
                "value": {
                  "error": "episode not found"
                }
              },
              "playerNotFound": {
                "value": {
                  "error": "player not found"
                }
              }
            }
          }
        },
        "headers": {
          "Cache-Control": {
            "$ref": "#/components/headers/NoStore"
          }
        }
      },
      "UnsupportedPlayback": {
