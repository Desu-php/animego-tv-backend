    "parameters": {
      "AnimeID": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Идентификатор аниме из поиска",
        "schema": {
          "$ref": "#/components/schemas/AnimeID"
        }
      },
      "EpisodeID": {
        "name": "episodeID",
        "in": "path",
        "required": true,
        "description": "Идентификатор серии из getEpisodes",
